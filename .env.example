# Only needed for --brain llm. The rule brain runs fully offline.

# Option A: Anthropic API directly
ANTHROPIC_API_KEY=

# Option B: LiteLLM proxy (Anthropic-compatible /v1/messages endpoint)
# ANTHROPIC_BASE_URL=https://your-litellm-host        # no trailing /v1
# ANTHROPIC_API_KEY=sk-your-litellm-key               # sent as x-api-key
# ANTHROPIC_AUTH_TOKEN=sk-your-litellm-key            # use this INSTEAD if the proxy wants "Authorization: Bearer"

# Model name as your endpoint knows it (LiteLLM may use an alias)
DISPUTE_AGENT_MODEL=claude-opus-5-5
# Real Anthropic model id used for cost tracking when DISPUTE_AGENT_MODEL is a proxy alias
# DISPUTE_AGENT_PRICE_MODEL=claude-opus-5-5

# Option C: OpenAI models (directly, or via LiteLLM's OpenAI-compatible endpoint)
# DISPUTE_AGENT_PROVIDER=openai
# OPENAI_BASE_URL=https://your-litellm-host/v1
# OPENAI_API_KEY=sk-your-key
# DISPUTE_AGENT_MODEL=openai/gpt-5.4-mini
# DISPUTE_AGENT_REASONING_EFFORT=low        # optional, reasoning models only
